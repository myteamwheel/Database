{
  "name": "nba-gleague-performance-database",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-v3.mjs && node scripts/build-artifact.mjs",
    "build:data": "node scripts/build-v3.mjs",
    "build:standalone": "node scripts/build-artifact.mjs",
    "audit": "node scripts/audit-v3.mjs",
    "fetch:nba": "node scripts/fetch-official.mjs 00 scripts/data/official_nba \"Regular Season\"",
    "fetch:gleague": "node scripts/fetch-official.mjs 20 scripts/data/official_gleague_regular \"Regular Season\"",
    "fetch:showcase": "node scripts/fetch-official.mjs 20 scripts/data/official_gleague_showcase \"Showcase\"",
    "fetch:stints": "node scripts/fetch-stints.mjs",
    "fetch:bios": "node scripts/fetch-player-bios.mjs",
    "fetch": "npm run fetch:nba && npm run fetch:gleague && npm run fetch:showcase && npm run fetch:stints && npm run fetch:splits",
    "refresh": "npm run fetch && npm run build:data && npm run fetch:bios && npm run fetch:birthdates && npm run build && npm run audit && npm run verify:artifact",
    "fetch:splits": "node scripts/fetch-splits.mjs",
    "fetch:birthdates": "node scripts/fetch-birthdates.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "k-sensitivity": "node scripts/k-sensitivity.mjs",
    "verify": "npm run audit && npm run audit:presets && npm run tulip:verify && npm run verify:artifact && npm run test:browser",
    "test:browser": "playwright test",
    "audit:presets": "node scripts/audit-presets.mjs",
    "diagnostics": "node scripts/diagnostics.mjs",
    "tulip:audit": "node scripts/tulip-audit.mjs",
    "tulip:verify": "node scripts/tulip-verify.mjs",
    "fetch:history": "node scripts/fetch-history.mjs",
    "audit:history": "node scripts/audit-history.mjs",
    "verify:history": "node scripts/verify-history-hashes.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}